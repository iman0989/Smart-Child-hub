# Production build configuration for Flutter Web.
#
# Copy this file to `config/production.env`, set your real HTTPS API URL, and
# build with:
#
#   flutter build web --release \
#     --dart-define-from-file=config/production.env \
#     --no-web-resources-cdn
#
# Never commit the filled-in copy if it ever contains anything secret. The API
# URL is the only value a Web build needs: authentication is a bearer token held
# at runtime, so no credential belongs in this file.

# Public HTTPS URL of the PHP API, with no trailing slash and no /api suffix.
API_BASE_URL=https://api.your-domain.example
